---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { renderCmsPage } from '../../lib/cms/render';

const { meta, html, page } = await renderCmsPage(
  '/projects',
  'Projects - Jacky FAN',
  'Projects by Jacky FAN.',
  { reserveNavbarHeight: false },
);
---

<BaseLayout title={meta.title} description={meta.description} reserveNavbarHeight={false} lpType="page" lpUrl="/projects" lpDepth={3} lpInitial={page}>
  <Fragment set:html={html} />
</BaseLayout>
