{
  "name": "v2.jacky.fan",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "astro dev -p 3000",
    "dev:full": "concurrently --kill-others --prefix \"[{name}]\" --prefix-colors yellow,cyan,magenta --names db,web,cms \"docker compose up mongo\" \"pnpm dev\" \"pnpm -C cms dev\"",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "upload": "astro build && wrangler versions upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "docker:build": "docker compose build --pull",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/cabin-sketch": "^5.3.0",
    "@fontsource/dosis": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "@payloadcms/live-preview": "3.92.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "24.19.2",
    "astro": "^7.4.2",
    "autoprefixer": "10.6.1",
    "daisyui": "^4.12.24",
    "locomotive-scroll": "^5.0.1",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.19",
    "three": "^0.186.1",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "concurrently": "^10.0.6",
    "sass": "^1.106.1",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "yarn": "please-use-pnpm",
    "npm": "please-use-pnpm"
  }
}
