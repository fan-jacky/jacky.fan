{
  "name": "v2.jacky.fan",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:full": "concurrently --kill-others --prefix \"[{name}]\" --prefix-colors yellow,cyan,magenta --names db,web,cms \"docker compose up mongo\" \"pnpm dev\" \"pnpm -C cms dev\"",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "eslint .",
    "docker:build": "docker compose build --pull",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "@fontsource/cabin-sketch": "^5.3.0",
    "@fontsource/dosis": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "@heroicons/react": "^2.2.0",
    "@opennextjs/cloudflare": "^1.20.13",
    "@payloadcms/live-preview-react": "3.92.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.1",
    "axios": "^1.20.0",
    "daisyui": "^5.7.50",
    "encoding": "^0.1.14",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "framer-motion": "^14.6.0",
    "locomotive-scroll": "^5.0.1",
    "next": "16.4.2",
    "postcss": "8.5.31",
    "react": "19.3.1",
    "react-click-away-listener": "^2.4.2",
    "react-dom": "19.3.1",
    "react-google-recaptcha-v3": "^1.11.0",
    "react-markdown": "^10.1.0",
    "sharp": "^0.35.5",
    "swiper": "^14.3.0",
    "tailwindcss": "4.3.3",
    "theme-change": "^3.0.4",
    "three": "^0.186.1",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "concurrently": "^10.0.6",
    "sass": "^1.106.1",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "yarn": "please-use-pnpm",
    "npm": "please-use-pnpm"
  }
}
