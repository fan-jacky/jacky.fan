# Development Dockerfile with live reloading support
FROM node:22.17.0-alpine

ENV PNPM_STORE_PATH=/app/.pnpm-store
ENV NODE_ENV=development
ENV CI=true

WORKDIR /app

# Install pnpm
RUN corepack enable pnpm && \
    apk add --no-cache libc6-compat

# Copy package files
COPY package.json pnpm-lock.yaml ./

# Don't install here - will be done at runtime to ensure fresh dependencies
# This allows the container to use the named volume for node_modules

# Expose port for Next.js dev server
EXPOSE 3000

# pnpm install will run when container starts (see docker-compose command)
CMD ["sh", "-c", "pnpm install --frozen-lockfile && pnpm run dev"]
